{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/feedback/**",
              "components/navigation/**",
              "components/surfaces/**",
              "ui_kits/wintick-app/**",
              "ui_kits/wintick-web/**",
              "ui_kits/wira-company/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Segoe UI Variable|Plus Jakarta Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Segoe UI Variable, Plus Jakarta Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|appearance|size|caps|dot|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, appearance, size, caps, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|neutral|gold|danger|warning|success)$/]",
        "message": "<Badge> tone must be one of 'brand' | 'neutral' | 'gold' | 'danger' | 'warning' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='appearance'] > Literal[value!=/^(?:solid|soft|outline)$/]",
        "message": "<Badge> appearance must be one of 'solid' | 'soft' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|fullWidth|iconLeft|iconRight|as|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, fullWidth, iconLeft, iconRight, as, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger|native)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger' | 'native'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|interactive|as|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, padding, interactive, as, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:elevated|outline|sunken|ink)$/]",
        "message": "<Card> variant must be one of 'elevated' | 'outline' | 'sunken' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg|xl)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|icon|native|width|onClose|onMin|onMax|footer|children|style|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: title, icon, native, width, onClose, onMin, onMax, footer, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Keycap'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|combo|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<Keycap> doesn't accept that prop. Declared props: children, combo, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Keycap'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Keycap> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Keycap'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|brand|ink|native)$/]",
        "message": "<Keycap> tone must be one of 'default' | 'brand' | 'ink' | 'native'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShortcutInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|native|disabled|style|key|ref|className|style|children)$/]",
        "message": "<ShortcutInput> doesn't accept that prop. Declared props: value, onChange, native, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|native|label|description|id|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, disabled, native, label, description, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrayIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|size|onDark|style|key|ref|className|style|children)$/]",
        "message": "<TrayIcon> doesn't accept that prop. Declared props: state, size, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrayIcon'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:normal|warning|error)$/]",
        "message": "<TrayIcon> state must be one of 'normal' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrayMenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|checked|key|ref|className|style|children)$/]",
        "message": "<TrayMenuItem> doesn't accept that prop. Declared props: kind, label, checked."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrayMenuItem'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:item|toggle|separator)$/]",
        "message": "<TrayMenuItem> kind must be one of 'item' | 'toggle' | 'separator'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
