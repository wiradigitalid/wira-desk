#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#define RT_MANIFEST 24

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "wiradesk.manifest"

// Shell icon. Generated from the same geometry as `src/icon.rs::base_pixmap` — the
// window motif drawn at runtime for the tray — so the executable and the tray icon
// cannot show different marks. Nine sizes from 16 to 256 px, 32-bpp with alpha.
1 ICON "wiradesk.ico"

// Product metadata. This is not cosmetic for this particular binary: the daemon
// requires elevation, and without a `FileDescription` the UAC consent prompt falls
// back to showing the bare filename. On an unsigned elevated program that already
// reads as "unverified publisher", a prompt that also cannot name the program is a
// worse thing to ask a user to approve.
//
// THE VERSION IS NOT WRITTEN IN THIS FILE. `build.rs` passes it as the four macros
// below, taken from `CARGO_PKG_VERSION`, which the root manifest defines once in
// `[workspace.package]`. A resource script cannot read `Cargo.toml`, and the previous
// answer was to duplicate the number here and guard the duplicate with a test — which
// worked for this file and silently did not exist for the Settings one.
//
// Two levels of macro are needed to turn `WD_VERSION` into a string literal, because a
// macro cannot be pasted into `"..."` directly. The indirection is what makes the outer
// one expand before it is stringized; a single-level version would emit the literal text
// `WD_VERSION` into the binary.
#define WD_STR_INNER(x) #x
#define WD_STR(x) WD_STR_INNER(x)

1 VERSIONINFO
FILEVERSION WD_MAJOR,WD_MINOR,WD_PATCH,0
PRODUCTVERSION WD_MAJOR,WD_MINOR,WD_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Wira Digital Indonesia"
            VALUE "FileDescription", "Wira Desk"
            VALUE "FileVersion", WD_STR(WD_VERSION)
            VALUE "InternalName", "wiradesk"
            VALUE "LegalCopyright", "Copyright (c) 2026 Wira Digital Indonesia"
            VALUE "OriginalFilename", "wiradesk.exe"
            VALUE "ProductName", "Wira Desk"
            VALUE "ProductVersion", WD_STR(WD_VERSION)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
