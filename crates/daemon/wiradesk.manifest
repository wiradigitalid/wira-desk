<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

    <assemblyIdentity

        version="1.0.0.0"

        processorArchitecture="*"

        name="WiraDesk"

        type="win32"

    />

    <description>Wira Desk Daemon</description>

    <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">

        <security>

            <requestedPrivileges>

                <requestedExecutionLevel

                    level="requireAdministrator"

                    uiAccess="false"

                />

            </requestedPrivileges>

        </security>

    </trustInfo>

 <!--

        Per-Monitor-V2 DPI awareness. Without this the daemon runs

        DPI-unaware: on a scaled display (e.g. 150%) Explorer sends tray

        anchor coordinates in PHYSICAL pixels, but TrackPopupMenu in an unaware

        process interprets them in VIRTUALIZED coordinate space → the menu is

        clamped far in the bottom-right corner instead of near the icon/cursor.

        PerMonitorV2 aligns the process coordinate space with the shell's physical

        coordinates (also the correct foundation for cross-monitor snapping in a

        later epic). `dpiAware` is a fallback for Windows 8.1 / older Windows 10 builds.

    -->

    <application xmlns="urn:schemas-microsoft-com:asm.v3">

        <windowsSettings>

            <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>

            <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>

        </windowsSettings>

    </application>

</assembly>

