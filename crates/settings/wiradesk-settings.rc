// Resources for the Settings executable.
//
// Deliberately NO manifest. Settings must not request elevation: it edits a file in
// `%APPDATA%` and needs no privilege the user does not already have, and the daemon
// launches it with `ShellExecuteW` so it inherits whatever the launcher had. Adding
// `requireAdministrator` here would put a UAC prompt in front of editing a shortcut.

// Shares the daemon's icon rather than carrying a second copy of the same bytes. The
// path is relative to this file, and `crates/` moves as one tree, so the reference
// holds in the public export too.
1 ICON "..\\daemon\\wiradesk.ico"

// THE VERSION IS NOT WRITTEN IN THIS FILE. `build.rs` passes it as the four macros
// below, taken from `CARGO_PKG_VERSION`, which the root manifest defines once in
// `[workspace.package]`.
//
// What used to be here was a duplicated literal plus a comment claiming that
// `version_resource_matches_cargo_manifest` asserted it matched. That test lives in the
// daemon crate and reads the daemon's own `wiradesk.rc`; nothing ever checked this file.
// So the number here could drift while the About screen — which reads
// `CARGO_PKG_VERSION` directly, in `src/main.rs` — kept reporting the true one, and the
// whole suite would stay green with the properties dialog and the About screen
// disagreeing. Generating it removes the duplicate rather than guarding it.
//
// `WD_STR` is two levels because a macro cannot be pasted into `"..."` directly; the
// indirection makes the inner one expand before it is stringized.
#define WD_STR_INNER(x) #x
#define WD_STR(x) WD_STR_INNER(x)

1 VERSIONINFO
FILEVERSION WD_MAJOR,WD_MINOR,WD_PATCH,0
PRODUCTVERSION WD_MAJOR,WD_MINOR,WD_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Wira Digital Indonesia"
            VALUE "FileDescription", "Wira Desk Settings"
            VALUE "FileVersion", WD_STR(WD_VERSION)
            VALUE "InternalName", "wiradesk-settings"
            VALUE "LegalCopyright", "Copyright (c) 2026 Wira Digital Indonesia"
            VALUE "OriginalFilename", "wiradesk-settings.exe"
            VALUE "ProductName", "Wira Desk"
            VALUE "ProductVersion", WD_STR(WD_VERSION)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
