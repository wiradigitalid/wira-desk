import { Palette, Typography } from "../theme.slint";

// One editable action.
//
// Every text in here is single-line and elides. That is not a style preference: this row's
// height comes from a preferred height that Slint computes at the text's *unwrapped* width,
// so a description that wrapped to two lines got a one-line row and its second line drew
// over the divider into the next row. Keeping each text to one line makes the row height
// deterministic instead of dependent on a measurement that is taken before wrapping.
export component ShortcutRow inherits Rectangle {
    in property <string> title: "Shortcut";
    in property <string> description: "Description text";
    in property <string> current_shortcut: "Win + `";
    in property <bool> is_listening: false;
    in property <string> conflict_name: "";
    in property <bool> has_conflict: conflict_name != "";
    in property <bool> can_swap: false;
    in property <bool> has_percent: false;
    in property <int> percent: 50;

    callback capture_clicked();
    callback swap_clicked();
    callback percent_changed(int);

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        alignment: space-between;

        // Left Content: Title + Subtext + Clean Dedicated Conflict Notice Line
        VerticalLayout {
            spacing: 3px;
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                font-family: Typography.font_family;
                font-size: Typography.size_subheading;
                font-weight: 600;
                color: Palette.text_primary;
            }

            Text {
                text: root.description;
                font-family: Typography.font_family;
                font-size: Typography.size_caption;
                color: Palette.text_secondary;
                // One line, always. See the note on this component's height above.
                wrap: no-wrap;
                overflow: elide;
            }

            if root.has_conflict : Text {
                text: "⚠ Conflicts with " + root.conflict_name;
                font-family: Typography.font_family;
                font-size: 11.5px;
                font-weight: 600;
                color: Palette.signal_warning;
                wrap: no-wrap;
                overflow: elide;
            }
        }

        // Right Actions: Swap button + Keycap button
        //
        // Wrapped in a centring VerticalLayout because the buttons must sit on the row's
        // vertical middle, and a row is as tall as its description — two lines on the longer
        // ones. The previous attempt set `y: (parent.height - 30px) / 2` on each button, which
        // could not work: a layout positions its own children, so `y` on a layout child is
        // discarded. That is why the keycap sat high against a two-line row.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

        HorizontalLayout {
            spacing: 6px;
            alignment: end;

            // Bounded numeric control for custom-percentage snap actions
            if root.has_percent : HorizontalLayout {
                spacing: 4px;
                alignment: center;

                // Minus button
                Rectangle {
                    width: 28px;
                    height: 30px;
                    border-radius: 4px;
                    background: pct_minus_touch.has_hover ? Palette.bg_card_hover : Palette.bg_keycap;
                    border-width: 1px;
                    border-color: Palette.stroke_card;

                    accessible-role: button;
                    accessible-label: "Decrease snap percentage";

                    Text {
                        text: "−";
                        font-size: 14px;
                        font-weight: 700;
                        color: Palette.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    pct_minus_touch := TouchArea {
                        clicked => {
                            root.percent_changed(Math.clamp(root.percent - 1, 1, 99));
                        }
                    }
                }

                // Value field (typed as well as stepped, bounded numeric control)
                Rectangle {
                    width: 58px;
                    height: 30px;
                    border-radius: 4px;
                    background: Palette.bg_subtle;
                    border-width: 1px;
                    border-color: pct_input.has-focus ? Palette.accent_primary : Palette.stroke_card;

                    pct_field_touch := TouchArea {
                        clicked => {
                            pct_input.focus();
                            pct_input.select-all();
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 1px;

                        pct_input := TextInput {
                            width: 26px;
                            text: "\{root.percent}";
                            input-type: number;
                            single-line: true;
                            font-family: Typography.font_mono;
                            font-size: 12px;
                            font-weight: 600;
                            color: Palette.text_primary;
                            horizontal-alignment: right;
                            vertical-alignment: center;

                            accessible-role: text;
                            accessible-label: "Snap percentage input";

                            accepted => {
                                if self.text.is-float() {
                                    root.percent_changed(Math.clamp(Math.round(self.text.to-float()), 1, 99));
                                } else {
                                    self.text = "\{root.percent}";
                                }
                                self.clear-focus();
                            }
                            changed has-focus => {
                                if !self.has-focus {
                                    if self.text.is-float() {
                                        root.percent_changed(Math.clamp(Math.round(self.text.to-float()), 1, 99));
                                    } else {
                                        self.text = "\{root.percent}";
                                    }
                                }
                            }
                        }

                        Text {
                            text: "%";
                            font-family: Typography.font_mono;
                            font-size: 12px;
                            font-weight: 600;
                            color: Palette.text_secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Plus button
                Rectangle {
                    width: 28px;
                    height: 30px;
                    border-radius: 4px;
                    background: pct_plus_touch.has_hover ? Palette.bg_card_hover : Palette.bg_keycap;
                    border-width: 1px;
                    border-color: Palette.stroke_card;

                    accessible-role: button;
                    accessible-label: "Increase snap percentage";

                    Text {
                        text: "+";
                        font-size: 14px;
                        font-weight: 700;
                        color: Palette.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    pct_plus_touch := TouchArea {
                        clicked => {
                            root.percent_changed(Math.clamp(root.percent + 1, 1, 99));
                        }
                    }
                }
            }

            // One-click Swap ⇄ button
            if root.has_conflict && root.can_swap : Rectangle {
                width: 60px;
                height: 30px;
                border-radius: 6px;
                background: swap_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle;
                border-width: 1px;
                border-color: Palette.stroke_card;

                Text {
                    text: "Swap ⇄";
                    font-family: Typography.font_family;
                    font-size: 11.5px;
                    font-weight: 600;
                    color: Palette.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                swap_touch := TouchArea {
                    clicked => { root.swap_clicked(); }
                }
            }

            // Keycap Button
            //
            // Width is computed from the label rather than fixed. A fixed 135px could not hold
            // `Ctrl + Alt + Shift + Enter`, and Slint's Text does not clip — the label simply
            // drew past both rounded ends and the shape looked broken.
            //
            // Driven off `lbl.width` and not `min-width` on purpose: `lbl` is a free-positioned
            // child, so its width is the natural width of its own text and nothing depends back
            // on the Rectangle. Relying on preferred-size derivation through an inner layout
            // would have been the same guess that produced the overflow.
            Rectangle {
                width: max(135px, lbl.width + 24px);
                height: 30px;
                border-radius: 6px;
                background: is_listening ? Palette.accent_primary : (has_conflict ? Palette.bg_conflict_keycap : Palette.bg_keycap);
                border-width: 1px;
                border-color: is_listening ? Palette.accent_primary : (has_conflict ? Palette.signal_warning : Palette.stroke_card);

                // A drawn dot, not an emoji. Neither loaded font carries U+1F534, and this is
                // the state a user reaches every time they rebind a chord — the worst possible
                // place for a tofu box.
                if root.is_listening : Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: #FFFFFF;
                    x: lbl.x - 12px;
                    y: (parent.height - 7px) / 2;
                }

                lbl := Text {
                    text: root.is_listening ? "Listening…" : root.current_shortcut;
                    font-family: Typography.font_family;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: is_listening ? #FFFFFF : (has_conflict ? Palette.signal_warning : Palette.text_primary);
                    x: (parent.width - self.width) / 2 + (root.is_listening ? 6px : 0px);
                    y: (parent.height - self.height) / 2;
                }

                btn_touch := TouchArea {
                    clicked => { root.capture_clicked(); }
                }
            }
        }

        }
    }
}
