import { Palette, Typography } from "../theme.slint";
import { ToggleSwitch } from "toggle_switch.slint";

// One editable action.
//
// Every text INSIDE the row is single-line and elides. That is not a style preference: the
// row's height comes from a preferred height that Slint computes at the text's *unwrapped*
// width, so a text that wrapped to two lines got a one-line row and its second line drew over
// the divider into the next row.
//
// The description used to be one of those texts and was the one that overflowed, so it now
// lives in the tooltip below instead, where wrapping is free because the tooltip is
// free-positioned rather than a layout child.
//
// What pins the row's height, now that the description is out of it and `min-height: 50px` has
// been deleted as inert: the right-hand cluster's 30px keycap plus this layout's 10px top and
// 10px bottom padding. Measured row pitch is 51px (50px + the 1px divider).
//
// The row is NOT one line tall in general, and an earlier version of this comment said so
// wrongly. Two states put a second line in `title_block` and the row grows to fit it, which is
// correct behaviour rather than the old defect: a conflict row and a disabled row both measure
// 52.5px. What the old defect was is different — text drawing OUTSIDE a row whose height had
// already been computed — and that is what keeping each text single-line still prevents.
//
// The mis-measurement above was re-confirmed while testing this change, and it is the reason a
// geometry test cannot see the defect: with the wrapping description put back, the row height
// did not move at all — the row stayed 50px and the text simply drew outside it. So a row-height
// assertion is not the guard for "the description is not a visible line"; reading the element
// tree is (`description_renders_as_a_tooltip_not_a_visible_line`), and the overflow it used to
// cause is a hand-verified smoke-test item.
export component ShortcutRow inherits Rectangle {
    min-height: 53px;
    in property <string> title: "Shortcut";
    in property <string> description: "Description text";
    in property <string> current_shortcut: "Win + `";
    in property <bool> is_listening: false;
    in property <string> conflict_name: "";
    in property <bool> has_conflict: conflict_name != "";
    in property <bool> can_swap: false;
    in property <bool> has_percent: false;
    in property <int> percent: 50;
    in property <int> percent_min: 1;
    in property <int> percent_max: 99;
    in property <string> accessible_label_decrease: "";
    in property <string> accessible_label_field: "";
    in property <string> accessible_label_input: "";
    in property <string> accessible_label_increase: "";
    in property <string> accessible_label_keycap: "";
    in property <string> accessible_label_description: "";
    in-out property <string> typed_text: "\{root.percent}";
    in property <bool> enabled: true;
    in property <int> revert_generation: 0;

    callback capture_clicked();
    callback swap_clicked();
    callback percent_changed(int);
    callback editing_changed(int);
    callback toggle_enabled(bool);
    callback show_tooltip(string, length);
    callback hide_tooltip();

    function current_value() -> int {
        if root.typed_text.is-float() {
            return Math.round(root.typed_text.to-float());
        }
        return root.percent;
    }

    public function step_plus() {
        let raw = root.current_value();
        let next = raw < root.percent_min ? root.percent_min : (raw < root.percent_max ? (raw + 1) : root.percent_max);
        root.typed_text = "\{next}";
        root.percent_changed(next);
    }

    public function step_minus() {
        let raw = root.current_value();
        let next = raw > root.percent_max ? root.percent_max : (raw > root.percent_min ? (raw - 1) : root.percent_min);
        root.typed_text = "\{next}";
        root.percent_changed(next);
    }

    public function commit_departure() {
        if root.typed_text.is-float() {
            let val = Math.round(root.typed_text.to-float());
            if val >= root.percent_min && val <= root.percent_max {
                root.percent_changed(val);
            } else {
                root.typed_text = "\{root.percent}";
                root.editing_changed(root.percent);
            }
        } else {
            root.typed_text = "\{root.percent}";
            root.editing_changed(root.percent);
        }
    }

    changed percent => {
        root.typed_text = "\{root.percent}";
    }

    changed revert_generation => {
        root.typed_text = "\{root.percent}";
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        alignment: space-between;

        // Left Content: Title + Clean Dedicated Conflict Notice Line (Description is now a hover/focus tooltip)
        title_block := FocusScope {
            horizontal-stretch: 1;
            accessible-role: text;
            accessible-label: root.accessible_label_description;
            accessible-description: root.description;

            focus_gained => {
                if root.description != "" {
                    root.show_tooltip(root.description, root.y + root.height + 2px);
                }
            }

            focus_lost => {
                if !title_touch.has-hover {
                    root.hide_tooltip();
                }
            }

            title_touch := TouchArea {
                width: 100%;
                height: 100%;

                changed has-hover => {
                    if self.has-hover {
                        if root.description != "" {
                            root.show_tooltip(root.description, root.y + root.height + 2px);
                        }
                    } else {
                        if !title_block.has-focus {
                            root.hide_tooltip();
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 3px;
                alignment: center;

                Text {
                    text: root.title;
                    font-family: Typography.font_family;
                    font-size: Typography.size_subheading;
                    font-weight: 600;
                    color: Palette.text_primary;
                }

                if root.has_conflict : Text {
                    text: "⚠ Conflicts with " + root.conflict_name;
                    font-family: Typography.font_family;
                    font-size: 11.5px;
                    font-weight: 600;
                    color: Palette.signal_warning;
                    wrap: no-wrap;
                    overflow: elide;
                }

                if !root.enabled : Text {
                    text: "Disabled";
                    font-family: Typography.font_family;
                    font-size: 11.5px;
                    font-weight: 600;
                    color: Palette.text_tertiary;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }

        // Right Actions: percentage stepper (where present) + Swap button + Keycap + enable toggle
        //
        // This outer `alignment: center` positions the whole cluster within the row. It is worth
        // knowing what it does and does not hold, because a previous version of this comment
        // credited it with the guard and that was wrong, measured both ways:
        //
        //  - Deleting it changes nothing on a one-line row, and on a two-line row it moves the
        //    cluster 1.5px (centre 215.5 -> 214) without ever separating keycap from toggle. No
        //    test fails either way.
        //  - The guard is the INNER `VerticalLayout { alignment: center }` around the
        //    `ToggleSwitch` further down. Delete that one and the 20px toggle top-aligns in the
        //    30px cluster: keycap centre 205, toggle centre 200, and
        //    `control_cluster_and_toggle_share_one_vertical_centre` goes red on a 5px gap against
        //    its 1px tolerance. Those are the same two numbers the original defect measured.
        //
        // The attempt before that set `y: (parent.height - 30px) / 2` on each button, which could
        // not work: a layout positions its own children, so `y` on a layout child is discarded.
        // That is why the keycap sat high. Do not go back to a `y:` expression — but do not
        // expect this outer line to catch you either.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

        HorizontalLayout {
            spacing: 6px;
            alignment: end;

            // Bounded numeric control for custom-percentage snap actions
            if root.has_percent : HorizontalLayout {
                spacing: 4px;
                alignment: center;

                // Minus button
                Rectangle {
                    width: 28px;
                    height: 30px;
                    border-radius: 4px;
                    background: pct_minus_touch.has_hover ? Palette.bg_card_hover : Palette.bg_keycap;
                    border-width: 1px;
                    border-color: Palette.stroke_card;

                    accessible-role: button;
                    accessible-label: root.accessible_label_decrease;
                    accessible-action-default => {
                        root.step_minus();
                    }

                    Text {
                        text: "−";
                        font-size: 14px;
                        font-weight: 700;
                        color: Palette.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    pct_minus_touch := TouchArea {
                        clicked => {
                            root.step_minus();
                        }
                    }
                }

                // Value field (typed as well as stepped, bounded numeric control)
                Rectangle {
                    width: 58px;
                    height: 30px;
                    border-radius: 4px;
                    background: Palette.bg_subtle;
                    border-width: 1px;
                    border-color: pct_input.has-focus ? Palette.accent_primary : Palette.stroke_card;

                    accessible-role: button;
                    accessible-label: root.accessible_label_field;
                    accessible-action-default => {
                        pct_input.focus();
                        pct_input.select-all();
                    }

                    pct_field_touch := TouchArea {
                        clicked => {
                            pct_input.focus();
                            pct_input.select-all();
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 1px;

                        pct_input := TextInput {
                            width: 26px;
                            text <=> root.typed_text;
                            input-type: number;
                            single-line: true;
                            font-family: Typography.font_mono;
                            font-size: 12px;
                            font-weight: 600;
                            color: Palette.text_primary;
                            horizontal-alignment: right;
                            vertical-alignment: center;

                            accessible-role: text;
                            accessible-label: root.accessible_label_input;
                            accessible-value: root.typed_text;
                            accessible-action-set-value(val) => {
                                root.typed_text = val;
                                if val.is-float() {
                                    root.editing_changed(Math.round(val.to-float()));
                                }
                            }

                            edited => {
                                if root.typed_text.is-float() {
                                    root.editing_changed(Math.round(root.typed_text.to-float()));
                                }
                            }

                            accepted => {
                                root.commit_departure();
                                self.clear-focus();
                            }
                            changed has-focus => {
                                if !self.has-focus {
                                    root.commit_departure();
                                }
                            }
                            key-pressed(event) => {
                                if event.text == Key.Tab || event.text == Key.Backtab {
                                    root.commit_departure();
                                    return reject;
                                }
                                reject
                            }
                        }

                        Text {
                            text: "%";
                            font-family: Typography.font_mono;
                            font-size: 12px;
                            font-weight: 600;
                            color: Palette.text_secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Plus button
                Rectangle {
                    width: 28px;
                    height: 30px;
                    border-radius: 4px;
                    background: pct_plus_touch.has_hover ? Palette.bg_card_hover : Palette.bg_keycap;
                    border-width: 1px;
                    border-color: Palette.stroke_card;

                    accessible-role: button;
                    accessible-label: root.accessible_label_increase;
                    accessible-action-default => {
                        root.step_plus();
                    }

                    Text {
                        text: "+";
                        font-size: 14px;
                        font-weight: 700;
                        color: Palette.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    pct_plus_touch := TouchArea {
                        clicked => {
                            root.step_plus();
                        }
                    }
                }
            }

            // One-click Swap ⇄ button
            if root.has_conflict && root.can_swap : Rectangle {
                width: 60px;
                height: 30px;
                border-radius: 6px;
                background: swap_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle;
                border-width: 1px;
                border-color: Palette.stroke_card;

                Text {
                    text: "Swap ⇄";
                    font-family: Typography.font_family;
                    font-size: 11.5px;
                    font-weight: 600;
                    color: Palette.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                swap_touch := TouchArea {
                    clicked => { root.swap_clicked(); }
                }
            }

            // Keycap Button
            //
            // Width is computed from the label rather than fixed. A fixed 135px could not hold
            // `Ctrl + Alt + Shift + Enter`, and Slint's Text does not clip — the label simply
            // drew past both rounded ends and the shape looked broken.
            //
            // Driven off `lbl.width` and not `min-width` on purpose: `lbl` is a free-positioned
            // child, so its width is the natural width of its own text and nothing depends back
            // on the Rectangle. Relying on preferred-size derivation through an inner layout
            // would have been the same guess that produced the overflow.
            Rectangle {
                width: max(135px, lbl.width + 24px);
                height: 30px;
                border-radius: 6px;
                background: is_listening ? Palette.accent_primary : (has_conflict ? Palette.bg_conflict_keycap : (root.enabled ? Palette.bg_keycap : Palette.bg_subtle));
                border-width: 1px;
                border-color: is_listening ? Palette.accent_primary : (has_conflict ? Palette.signal_warning : Palette.stroke_card);

                accessible-role: button;
                accessible-label: root.accessible_label_keycap;
                accessible-action-default => {
                    root.capture_clicked();
                }

                // A drawn dot, not an emoji. Neither loaded font carries U+1F534, and this is
                // the state a user reaches every time they rebind a chord — the worst possible
                // place for a tofu box.
                if root.is_listening : Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: #FFFFFF;
                    x: lbl.x - 12px;
                    y: (parent.height - 7px) / 2;
                }

                lbl := Text {
                    text: root.is_listening ? "Listening…" : root.current_shortcut;
                    font-family: Typography.font_family;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: is_listening ? #FFFFFF : (has_conflict ? Palette.signal_warning : (root.enabled ? Palette.text_primary : Palette.text_tertiary));
                    x: (parent.width - self.width) / 2 + (root.is_listening ? 6px : 0px);
                    y: (parent.height - self.height) / 2;
                }

                btn_touch := TouchArea {
                    clicked => { root.capture_clicked(); }
                }
            }

            VerticalLayout {
                alignment: center;
                ToggleSwitch {
                    checked: root.enabled;
                    accessible-label: "Enable " + root.title;
                    toggled(val) => { root.toggle_enabled(val); }
                }
            }
        }

        }
    }
}
