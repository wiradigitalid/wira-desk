import { Palette, Typography } from "theme.slint";
import { Card, CardDivider } from "components/card.slint";
import { ToggleSwitch } from "components/toggle_switch.slint";

// One row of the "what this does" cards, on the first and last screens.
//
// A component because it had been written by hand five times, and the copies had drifted in
// two ways that are structural rather than typographical. None of the description texts set
// `wrap`, so the longest of them ran outside the card and the tail of the sentence was drawn
// past its edge. And the glyph had no column, so no two rows lined up: emoji, symbols, and
// letters have very different advance widths in Segoe UI, and each row started its text
// wherever its own glyph happened to end.
component InfoRow inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> title;
    in property <string> body;

    spacing: 10px;

    // A floor and a little air. Observed on screen: the one-line row read as visibly
    // shorter than its neighbours, and a row whose description wrapped to two lines put
    // that second line hard against the card's edge. The floor evens out the first, the
    // padding relieves the second, and both are here rather than in the card so every use
    // of this row gets them.
    min-height: 44px;
    padding-top: 5px;
    padding-bottom: 5px;

    // Fixed width, so every row's text begins at the same x whatever glyph sits above it.
    Rectangle {
        width: 24px;
        Text {
            text: root.glyph;
            font-size: 16px;
            horizontal-alignment: center;
            vertical-alignment: top;
            y: 1px;
        }
    }

    VerticalLayout {
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            font-family: Typography.font_family;
            font-size: 13.5px;
            font-weight: 600;
            color: Palette.text_primary;
        }
        Text {
            text: root.body;
            font-family: Typography.font_family;
            font-size: 12px;
            color: Palette.text_secondary;
            wrap: word-wrap;
        }
    }

    // Whatever the row needs on its right, such as a toggle.
    @children
}

export component OnboardingModal inherits Rectangle {
    in property <int> current_step: 1; // 1 = Welcome, 2 = TrySwitching, 3 = Done
    in property <int> focus_index: 0; // 0 = Window 1, 1 = Window 2
    in property <bool> simulation_success: false;

    callback next_clicked();
    callback back_clicked();
    callback skip_clicked();
    callback finish_clicked();
    callback simulate_clicked();

    // Onboarding carries no titlebar, so the window would otherwise be immovable: the
    // main window is `no-frame`, and the only surface that emitted a drag was the
    // titlebar this branch no longer draws. Settings keeps its titlebar and keeps
    // dragging from there; this is the onboarding-only replacement.
    callback drag_requested();

    // Start-at-sign-in, asked on the last screen. Pre-checked, and bound to a property
    // separate from the Settings one: skipping the tutorial must not answer a question the
    // user never saw.
    in-out property <bool> auto_start: true;
    callback auto_start_toggled(bool);

    background: Palette.bg_card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Palette.stroke_card;

    VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-top: 18px;
        padding-bottom: 24px;
        alignment: space-between;

        // 1. Top Section: Progress Bar + Heading + Description
        VerticalLayout {
            spacing: 12px;

            // 3-Segment Progress Indicator Bar
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: root.current_step >= 1 ? Palette.accent_primary : Palette.bg_keycap;
                }
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: root.current_step >= 2 ? Palette.accent_primary : Palette.bg_keycap;
                }
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: root.current_step >= 3 ? Palette.accent_primary : Palette.bg_keycap;
                }
            }

            // Headings
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: root.current_step == 1 ? "Welcome to Wira Desk" :
                          (root.current_step == 2 ? "Try switching windows" : "You are all set");
                    font-family: Typography.font_family;
                    font-size: 20px;
                    font-weight: 700;
                    color: Palette.text_primary;
                }

                Text {
                    text: root.current_step == 1 ?
                          "Wira Desk switches instantly between windows of the application you are currently using, instead of cycling through every open window like Alt+Tab. Window focus stays strictly on your active physical monitor and virtual desktop, eliminating multi-monitor distractions." :
                          (root.current_step == 2 ?
                          "Practice switching focus between two windows of the same app. Press Win + ` (backtick) on your keyboard or click the practice button below to watch focus shift with zero HUD delay." :
                          "Wira Desk is now resident and active in your System Tray. You can customize shortcuts, snapping parameters, and VM passthrough rules anytime from Settings.");
                    font-family: Typography.font_family;
                    font-size: 13px;
                    color: Palette.text_secondary;
                    wrap: word-wrap;
                }
            }
        }

        // 2. Middle Content Area
        //
        // `alignment: start` is the fix for the empty band above the card. The outer layout
        // is `space-between` so the footer pins to the bottom — correct — and this region
        // absorbs the slack. Without an alignment the card was centred inside that slack,
        // so a compact screen showed a gap above the card and another below it. Now the
        // card sits under the heading and the slack collects in one place, above the footer,
        // where it reads as a margin rather than as two holes.
        VerticalLayout {
            alignment: start;
            padding-top: 10px;
            padding-bottom: 10px;

            // Step 1: Feature Cards
            if root.current_step == 1 : Rectangle {
                background: Palette.bg_subtle;
                border-radius: 10px;
                border-width: 1px;
                border-color: Palette.stroke_card;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    InfoRow {
                        glyph: "⚡";
                        title: "Same-Application Spatial Cycling";
                        body: "Press Win + ` to cycle focus between windows of the active app with zero visual delay.";
                    }

                    CardDivider {}

                    InfoRow {
                        glyph: "🔒";
                        title: "Spatial Preservation Lock";
                        body: "Focus never jumps to another physical display or background virtual desktop unintentionally.";
                    }
                }
            }

            // Step 2: Interactive Sandbox Dummy Windows
            if root.current_step == 2 : Rectangle {
                background: Palette.bg_subtle;
                border-radius: 10px;
                border-width: 1px;
                border-color: Palette.stroke_card;

                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 12px;

                        // Dummy Window 1
                        Rectangle {
                            height: 72px;
                            border-radius: 8px;
                            background: root.focus_index == 0 ? Palette.bg_card_hover : Palette.bg_card;
                            border-width: root.focus_index == 0 ? 1.5px : 1px;
                            border-color: root.focus_index == 0 ? Palette.accent_primary : Palette.stroke_card;

                            VerticalLayout {
                                alignment: space-between;
                                Rectangle {
                                    height: 22px;
                                    background: Palette.bg_keycap;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; alignment: space-between;
                                        Text { text: "Document 1"; font-size: 11px; font-weight: 600; color: root.focus_index == 0 ? Palette.accent_primary : Palette.text_secondary; vertical-alignment: center; }
                                        Text { text: "✕"; font-size: 9.5px; color: Palette.text_tertiary; vertical-alignment: center; }
                                    }
                                }
                                VerticalLayout {
                                    padding-left: 8px; padding-bottom: 6px;
                                    Text { text: "Project Brief.docx"; font-size: 11.5px; font-weight: 600; color: Palette.text_primary; }
                                    Text { text: root.focus_index == 0 ? "Active Window" : "Background"; font-size: 10.5px; color: Palette.text_secondary; }
                                }
                            }
                        }

                        // Dummy Window 2
                        Rectangle {
                            height: 72px;
                            border-radius: 8px;
                            background: root.focus_index == 1 ? Palette.bg_card_hover : Palette.bg_card;
                            border-width: root.focus_index == 1 ? 1.5px : 1px;
                            border-color: root.focus_index == 1 ? Palette.accent_primary : Palette.stroke_card;

                            VerticalLayout {
                                alignment: space-between;
                                Rectangle {
                                    height: 22px;
                                    background: Palette.bg_keycap;
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; alignment: space-between;
                                        Text { text: "Document 2"; font-size: 11px; font-weight: 600; color: root.focus_index == 1 ? Palette.accent_primary : Palette.text_secondary; vertical-alignment: center; }
                                        Text { text: "✕"; font-size: 9.5px; color: Palette.text_tertiary; vertical-alignment: center; }
                                    }
                                }
                                VerticalLayout {
                                    padding-left: 8px; padding-bottom: 6px;
                                    Text { text: "Design System.docx"; font-size: 11.5px; font-weight: 600; color: Palette.text_primary; }
                                    Text { text: root.focus_index == 1 ? "Active Window" : "Background"; font-size: 10.5px; color: Palette.text_secondary; }
                                }
                            }
                        }
                    }

                    // Simulation Button + Live Feedback
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 170px;
                            height: 28px;
                            border-radius: 6px;
                            background: sim_touch.has_hover ? Palette.bg_card_hover : Palette.bg_keycap;
                            border-width: 1px;
                            border-color: Palette.stroke_card;

                            Text {
                                text: "Win + ` (Click to simulate)";
                                font-family: Typography.font_mono;
                                font-size: 11px;
                                font-weight: 600;
                                color: Palette.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            sim_touch := TouchArea {
                                clicked => { root.simulate_clicked(); }
                            }
                        }

                        if root.focus_index == 1 : Text {
                            text: "✔ Focus shifted to Document 2";
                            font-size: 12px;
                            font-weight: 600;
                            color: Palette.signal_success;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Step 3: Resident Confirmation
            if root.current_step == 3 : Rectangle {
                background: Palette.bg_subtle;
                border-radius: 10px;
                border-width: 1px;
                border-color: Palette.stroke_card;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    InfoRow {
                        glyph: "🚀";
                        title: "System Tray Resident";
                        body: "Wira Desk runs quietly in the background. Right-click the tray icon anytime for Settings.";
                    }

                    CardDivider {}

                    InfoRow {
                        glyph: "⌨";
                        title: "Fully Customizable";
                        body: "Customize shortcuts, window snapping parameters, and VM passthrough rules anytime.";
                    }

                    CardDivider {}

                    // The one decision this tutorial asks for. It is here rather than in the
                    // installer because the installer runs elevated and possibly as a different
                    // account, and the task it would create has to name the interactive user;
                    // and because a silent install has no wizard, so winget users would never
                    // have been asked at all.
                    InfoRow {
                        // An emoji rather than the "↻" symbol that was here first: a plain
                        // arrow renders as a thin monochrome glyph beside four colour emoji,
                        // which reads as a missing character rather than a deliberate one.
                        glyph: "🔄";
                        title: "Start with Windows";
                        body: "Comes back after every sign-in. Change it any time in Settings.";
                        ToggleSwitch {
                            y: 3px;
                            checked <=> root.auto_start;
                            toggled(val) => { root.auto_start_toggled(val); }
                        }
                    }
                }
            }
        }

        // 3. Pinned Action Navigation Footer
        HorizontalLayout {
            alignment: space-between;
            height: 34px;

            if root.current_step == 1 : Rectangle {
                width: 105px;
                height: 34px;
                border-radius: 6px;
                background: skip_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle;

                Text {
                    text: "Skip Tutorial";
                    font-family: Typography.font_family;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: Palette.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                skip_touch := TouchArea {
                    clicked => { root.skip_clicked(); }
                }
            }

            if root.current_step > 1 : Rectangle {
                width: 90px;
                height: 34px;
                border-radius: 6px;
                background: back_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle;

                Text {
                    text: "← Back";
                    font-family: Typography.font_family;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: Palette.text_primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                back_touch := TouchArea {
                    clicked => { root.back_clicked(); }
                }
            }

            if root.current_step < 3 : Rectangle {
                width: 90px;
                height: 34px;
                border-radius: 6px;
                background: next_touch.has_hover ? Palette.accent_hover : Palette.accent_primary;

                Text {
                    text: "Next";
                    font-family: Typography.font_family;
                    font-size: 13px;
                    font-weight: 700;
                    color: Palette.text_on_accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                next_touch := TouchArea {
                    clicked => { root.next_clicked(); }
                }
            }

            if root.current_step == 3 : Rectangle {
                width: 170px;
                height: 34px;
                border-radius: 6px;
                background: finish_touch.has_hover ? Palette.accent_hover : Palette.accent_primary;

                Text {
                    text: "Start Using Wira Desk";
                    font-family: Typography.font_family;
                    font-size: 13px;
                    font-weight: 700;
                    color: Palette.text_on_accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                finish_touch := TouchArea {
                    clicked => { root.finish_clicked(); }
                }
            }
        }
    }

    // Drag strip: the top edge down through the progress indicator, and no further.
    //
    // 34px is measured rather than chosen: the layout above has 18px of top padding,
    // the indicator bars are 4px, and the next element starts after 12px of spacing.
    // So 34px covers exactly the indicator and everything above it, and stops before
    // the heading. Nothing in that band is interactive, which is why a plain overlay is
    // safe here; extending it over the whole modal would put a drag surface underneath
    // buttons, and a window that slides when you press Next is worse than one you grab
    // by the top.
    //
    // Declared last so it sits above the layout. It has to, to receive the press.
    TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: 34px;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.drag_requested();
            }
        }
    }
}
