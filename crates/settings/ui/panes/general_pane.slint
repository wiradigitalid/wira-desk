import { Palette, Typography } from "../theme.slint";
import { Card, CardDivider } from "../components/card.slint";
import { SettingToggleRow } from "../components/setting_toggle_row.slint";

export component GeneralPane inherits VerticalLayout {
    in-out property <bool> auto_start: false;
    in property <bool> is_elevated: true;

    callback auto_start_toggled(bool);

    spacing: 12px;
    alignment: start;

    // Heading Section
    VerticalLayout {
        spacing: 2px;
        Text {
            text: "General Settings";
            font-family: Typography.font_family;
            font-size: Typography.size_heading;
            font-weight: 700;
            color: Palette.text_primary;
        }
        Text {
            text: "Startup integration and multi-monitor spatial settings.";
            font-family: Typography.font_family;
            font-size: Typography.size_caption;
            color: Palette.text_secondary;
        }
    }

    // Card 1: Startup & System Integration
    Card {
        SettingToggleRow {
            title: "Start Wira Desk with Windows";
            description: "Runs quietly in the background as an elevated scheduled task.";
            checked <=> root.auto_start;
            toggled(val) => { root.auto_start_toggled(val); }
        }
    }

    // Card 2: Spatial & Isolation Philosophy (Display only)
    Card {
        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            SettingToggleRow {
                title: "Spatial Preservation Lock";
                description: "Window focus cycles exclusively within the active physical monitor and virtual desktop.";
                checked: true;
                enabled: false;
            }

            CardDivider {}

            SettingToggleRow {
                title: "Show Unresponsive Windows (UX Honesty)";
                description: "Ensures hanging windows are exposed cleanly to the user rather than hidden.";
                checked: true;
                enabled: false;
            }
        }
    }
}
