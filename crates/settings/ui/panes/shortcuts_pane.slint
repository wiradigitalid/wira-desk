import { Palette, Typography } from "../theme.slint";
import { Card, CardDivider } from "../components/card.slint";
import { ShortcutRow } from "../components/shortcut_row.slint";

// One editable action, as the pane needs it.
//
// The pane is driven entirely by these rows rather than by one property per field. Nine
// actions times four properties was thirty-six hand-written bindings, which is the shape
// that lets an action be added to the model and silently never drawn. `index` is the
// action's position in the declared sequence (`LBR-ST-14`) and is what the capture and swap
// callbacks carry back; it is deliberately not the row's position inside its group.
export struct ShortcutRowData {
    index: int,
    title: string,
    description: string,
    shortcut: string,
    conflict_name: string,
    can_swap: bool,
    has_percent: bool,
    percent: int,
    percent_min: int,
    percent_max: int,
    accessible_label_decrease: string,
    accessible_label_field: string,
    accessible_label_input: string,
    accessible_label_increase: string,
    enabled: bool,
}

// A labelled group of rows: one card, one heading.
component ShortcutGroup inherits VerticalLayout {
    in property <string> heading;
    in property <[ShortcutRowData]> rows;
    in property <int> listening_field: -1;

    callback capture(int);
    callback swap(int);
    callback percent_changed(int, int);
    callback editing_changed(int, int);
    callback toggle_enabled(int, bool);

    spacing: 6px;

    Text {
        text: root.heading;
        font-family: Typography.font_family;
        font-size: Typography.size_caption;
        font-weight: 600;
        letter-spacing: 0.8px;
        color: Palette.text_secondary;
    }

    Card {
        VerticalLayout {
            padding: 0px;
            for row[i] in root.rows: VerticalLayout {
                if i > 0: CardDivider {}
                ShortcutRow {
                    title: row.title;
                    description: row.description;
                    current_shortcut: row.shortcut;
                    is_listening: root.listening_field == row.index;
                    conflict_name: row.conflict_name;
                    can_swap: row.can_swap;
                    has_percent: row.has_percent;
                    percent: row.percent;
                    percent_min: row.percent_min;
                    percent_max: row.percent_max;
                    accessible_label_decrease: row.accessible_label_decrease;
                    accessible_label_field: row.accessible_label_field;
                    accessible_label_input: row.accessible_label_input;
                    accessible_label_increase: row.accessible_label_increase;
                    enabled: row.enabled;
                    capture_clicked => {
                        root.capture(row.index);
                    }
                    swap_clicked => {
                        root.swap(row.index);
                    }
                    percent_changed(val) => {
                        root.percent_changed(row.index, val);
                    }
                    editing_changed(val) => {
                        root.editing_changed(row.index, val);
                    }
                    toggle_enabled(val) => {
                        root.toggle_enabled(row.index, val);
                    }
                }
            }
        }
    }
}

export component ShortcutsPane inherits VerticalLayout {
    // Five groups, taxonomy per `DEC-014` (`LBR-ST-14`), driven from `ShortcutField::ALL`.
    in property <[ShortcutRowData]> rows_switching;
    in property <[ShortcutRowData]> rows_snap_half;
    in property <[ShortcutRowData]> rows_snap_third;
    in property <[ShortcutRowData]> rows_snap_custom;
    in property <[ShortcutRowData]> rows_arrange;

    in property <int> listening_field: -1; // -1 = idle, otherwise the action's index

    // The Key check diagnostic is deliberately NOT here. It is a live instrument — you press
    // a chord and read what it observed — so it has to stay visible while you are editing the
    // rows. Nine rows scroll it off the screen at exactly the moment it is useful, so the
    // shell pins it in a band of its own above the save footer. See `main_window.slint`.

    callback start_capture(int);
    callback swap_shortcuts(int);
    callback percent_changed(int, int);
    callback editing_percent_changed(int, int);
    callback toggle_enabled(int, bool);

    spacing: 14px;
    alignment: start;

    // Heading Section
    VerticalLayout {
        spacing: 2px;
        Text {
            text: "Shortcuts Configuration";
            font-family: Typography.font_family;
            font-size: Typography.size_heading;
            font-weight: 700;
            color: Palette.text_primary;
        }

        Text {
            text: "Click any shortcut button to record physical key combinations directly. Every action Wira Desk can trigger lives here.";
            font-family: Typography.font_family;
            font-size: Typography.size_caption;
            color: Palette.text_secondary;
            wrap: word-wrap;
        }
    }

    // Guidance for CHOOSING a chord, so it sits where the reader starts rather than at the
    // bottom of the Key check card, which reports what a keypress already did. A sibling of
    // the groups rather than part of the title block above: that block is spaced at 2px
    // because it is a title and its subtitle, and a third line crammed into it reads as a
    // continuation of the subtitle instead of a separate note.
    Text {
        text: "💡 Tip: Windows reserves Win + 1..9, Win + E, Win + D, and Win + Ctrl + ←/→. Wira Desk ships on Ctrl + Alt + ... — a good family for custom actions too.";
        font-family: Typography.font_family;
        font-size: Typography.size_caption;
        color: Palette.accent_primary;
        wrap: word-wrap;
    }

    ShortcutGroup {
        heading: "Switching";
        rows: root.rows_switching;
        listening_field: root.listening_field;
        capture(i) => {
            root.start_capture(i);
        }
        swap(i) => {
            root.swap_shortcuts(i);
        }
        percent_changed(i, val) => {
            root.percent_changed(i, val);
        }
        editing_changed(i, val) => {
            root.editing_percent_changed(i, val);
        }
        toggle_enabled(i, val) => {
            root.toggle_enabled(i, val);
        }
    }

    ShortcutGroup {
        heading: "Snap to half";
        rows: root.rows_snap_half;
        listening_field: root.listening_field;
        capture(i) => {
            root.start_capture(i);
        }
        swap(i) => {
            root.swap_shortcuts(i);
        }
        percent_changed(i, val) => {
            root.percent_changed(i, val);
        }
        editing_changed(i, val) => {
            root.editing_percent_changed(i, val);
        }
        toggle_enabled(i, val) => {
            root.toggle_enabled(i, val);
        }
    }

    ShortcutGroup {
        heading: "Snap to third";
        rows: root.rows_snap_third;
        listening_field: root.listening_field;
        capture(i) => {
            root.start_capture(i);
        }
        swap(i) => {
            root.swap_shortcuts(i);
        }
        percent_changed(i, val) => {
            root.percent_changed(i, val);
        }
        editing_changed(i, val) => {
            root.editing_percent_changed(i, val);
        }
        toggle_enabled(i, val) => {
            root.toggle_enabled(i, val);
        }
    }

    ShortcutGroup {
        heading: "Snap to custom";
        rows: root.rows_snap_custom;
        listening_field: root.listening_field;
        capture(i) => {
            root.start_capture(i);
        }
        swap(i) => {
            root.swap_shortcuts(i);
        }
        percent_changed(i, val) => {
            root.percent_changed(i, val);
        }
        editing_changed(i, val) => {
            root.editing_percent_changed(i, val);
        }
        toggle_enabled(i, val) => {
            root.toggle_enabled(i, val);
        }
    }

    ShortcutGroup {
        heading: "Resize, move & arrange";
        rows: root.rows_arrange;
        listening_field: root.listening_field;
        capture(i) => {
            root.start_capture(i);
        }
        swap(i) => {
            root.swap_shortcuts(i);
        }
        percent_changed(i, val) => {
            root.percent_changed(i, val);
        }
        editing_changed(i, val) => {
            root.editing_percent_changed(i, val);
        }
        toggle_enabled(i, val) => {
            root.toggle_enabled(i, val);
        }
    }
}
