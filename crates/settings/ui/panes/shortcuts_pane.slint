import { Palette, Typography } from "../theme.slint";
import { Card, CardDivider } from "../components/card.slint";
import { ShortcutRow } from "../components/shortcut_row.slint";
import { KeyCheck } from "../components/key_check.slint";

// One editable action, as the pane needs it.
//
// The pane is driven entirely by these rows rather than by one property per field. Nine
// actions times four properties was thirty-six hand-written bindings, which is the shape
// that lets an action be added to the model and silently never drawn. `index` is the
// action's position in the declared sequence (`LBR-ST-14`) and is what the capture and swap
// callbacks carry back; it is deliberately not the row's position inside its group.
export struct ShortcutRowData {
    index: int,
    title: string,
    description: string,
    shortcut: string,
    conflict_name: string,
    can_swap: bool,
}

// A labelled group of rows: one card, one heading.
component ShortcutGroup inherits VerticalLayout {
    in property <string> heading;
    in property <[ShortcutRowData]> rows;
    in property <int> listening_field: -1;

    callback capture(int);
    callback swap(int);

    spacing: 6px;

    Text {
        text: root.heading;
        font-family: Typography.font_family;
        font-size: Typography.size_caption;
        font-weight: 600;
        letter-spacing: 0.8px;
        color: Palette.text_secondary;
    }

    Card {
        VerticalLayout {
            padding: 0px;
            for row[i] in root.rows: VerticalLayout {
                if i > 0: CardDivider {}
                ShortcutRow {
                    title: row.title;
                    description: row.description;
                    current_shortcut: row.shortcut;
                    is_listening: root.listening_field == row.index;
                    conflict_name: row.conflict_name;
                    can_swap: row.can_swap;
                    capture_clicked => {
                        root.capture(row.index);
                    }
                    swap_clicked => {
                        root.swap(row.index);
                    }
                }
            }
        }
    }
}

export component ShortcutsPane inherits VerticalLayout {
    // Three groups, mirroring the three configuration sections already on disk
    // (`[switcher]`, `[snapping]`, `[layout]`), so what a user sees and what the product
    // stores stop telling different stories.
    in property <[ShortcutRowData]> rows_switching;
    in property <[ShortcutRowData]> rows_snap;
    in property <[ShortcutRowData]> rows_move;

    in property <int> listening_field: -1; // -1 = idle, otherwise the action's index

    // KeyCheck Diagnostic Card Properties
    in property <bool> kc_mod_ctrl: false;
    in property <bool> kc_mod_win: false;
    in property <bool> kc_mod_alt: false;
    in property <bool> kc_mod_shift: false;
    in property <string> kc_last_display: "";
    in property <string> kc_last_canonical: "";
    in property <int> kc_verdict: 0;
    in property <bool> kc_beat: false;

    callback start_capture(int);
    callback swap_shortcuts(int);
    callback key_check_beat_done();

    spacing: 14px;
    alignment: start;

    // Heading Section
    VerticalLayout {
        spacing: 2px;
        Text {
            text: "Shortcuts Configuration";
            font-family: Typography.font_family;
            font-size: Typography.size_heading;
            font-weight: 700;
            color: Palette.text_primary;
        }

        Text {
            text: "Click any shortcut button to record physical key combinations directly. Every action Wira Desk can trigger lives here.";
            font-family: Typography.font_family;
            font-size: Typography.size_caption;
            color: Palette.text_secondary;
            wrap: word-wrap;
        }
    }

    ShortcutGroup {
        heading: "Switching";
        rows: root.rows_switching;
        listening_field: root.listening_field;
        capture(i) => {
            root.start_capture(i);
        }
        swap(i) => {
            root.swap_shortcuts(i);
        }
    }

    ShortcutGroup {
        heading: "Snap & resize";
        rows: root.rows_snap;
        listening_field: root.listening_field;
        capture(i) => {
            root.start_capture(i);
        }
        swap(i) => {
            root.swap_shortcuts(i);
        }
    }

    ShortcutGroup {
        heading: "Move & arrange";
        rows: root.rows_move;
        listening_field: root.listening_field;
        capture(i) => {
            root.start_capture(i);
        }
        swap(i) => {
            root.swap_shortcuts(i);
        }
    }

    // KeyCheck Live Keyboard Diagnostic & Responsiveness Card
    KeyCheck {
        mod_ctrl: root.kc_mod_ctrl;
        mod_win: root.kc_mod_win;
        mod_alt: root.kc_mod_alt;
        mod_shift: root.kc_mod_shift;
        last_display: root.kc_last_display;
        last_canonical: root.kc_last_canonical;
        verdict: root.kc_verdict;
        beat: root.kc_beat;
        beat_done => {
            root.key_check_beat_done();
        }
    }
}
