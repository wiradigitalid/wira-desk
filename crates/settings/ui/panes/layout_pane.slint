import { Palette, Typography } from "../theme.slint";
import { Card, CardDivider } from "../components/card.slint";
import { ToggleSwitch } from "../components/toggle_switch.slint";

export component LayoutPane inherits VerticalLayout {
    in-out property <int> stack_width_percent: 50;

    // The daemon accepts any percentage in this range.
    property <int> min_percent: 10;
    property <int> max_percent: 100;
    property <int> step: 1;

    callback width_changed(int);
    callback editing_width_changed(int);

    function current_value() -> int {
        if input.text.is-float() {
            return Math.round(input.text.to-float());
        }
        return root.stack_width_percent;
    }

    // Bounded stepper buttons step within range, while typed inputs forward
    // unclamped values so out-of-range percentages are rejected with actionable
    // feedback rather than silently clamped.
    public function step_plus() {
        let base = root.current_value();
        let next = (base >= root.min_percent && base < root.max_percent) ? (base + root.step) : base;
        input.text = "\{next}";
        root.stack_width_percent = next;
        root.width_changed(next);
    }

    public function step_minus() {
        let base = root.current_value();
        let next = (base > root.min_percent && base <= root.max_percent) ? (base - root.step) : base;
        input.text = "\{next}";
        root.stack_width_percent = next;
        root.width_changed(next);
    }

    // Typed values are forwarded unclamped. Out-of-range values are refused
    // before save with an actionable error message instead of silently clamped.
    // Garbage in the field reverts to the value in force rather than
    // committing a zero.
    public function commit_typed() {
        if input.text.is-float() {
            let val = Math.round(input.text.to-float());
            root.stack_width_percent = val;
            root.width_changed(val);
        } else {
            input.text = "\{root.stack_width_percent}";
        }
    }

    // Typing into a TextInput breaks its `text` binding, so the field is
    // pushed back explicitly whenever the value moves under it: the buttons,
    // Revert, or a reload from disk.
    changed stack_width_percent => {
        input.text = "\{root.stack_width_percent}";
    }

    spacing: 12px;
    alignment: start;

    // Heading Section
    VerticalLayout {
        spacing: 2px;
        Text {
            text: "Layout";
            accessible-role: text;
            accessible-label: "Layout pane heading";
            accessible-value: self.text;
            font-family: Typography.font_family;
            font-size: Typography.size_heading;
            font-weight: 700;
            color: Palette.text_primary;
        }
        Text {
            text: "DPI-aware window snapping and compact overlapping stack arrangement.";
            font-family: Typography.font_family;
            font-size: Typography.size_caption;
            color: Palette.text_secondary;
        }
    }

    Card {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Stack Width Ratio
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: "Stack Width Ratio";
                        font-family: Typography.font_family;
                        font-size: Typography.size_subheading;
                        font-weight: 600;
                        color: Palette.text_primary;
                    }
                    Text {
                        text: "Percentage of screen width allocated to stacked windows (" + root.stack_width_percent + "%).";
                        font-family: Typography.font_family;
                        font-size: Typography.size_caption;
                        color: Palette.text_secondary;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    // Minus button
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 4px;
                        background: minus_touch.has_hover ? Palette.bg_card_hover : Palette.bg_keycap;
                        border-width: 1px;
                        border-color: Palette.stroke_card;

                        accessible-role: button;
                        accessible-label: "Decrease stack width";
                        accessible-action-default => {
                            root.step_minus();
                        }

                        Text {
                            text: "−";
                            font-size: 14px;
                            font-weight: 700;
                            color: Palette.text_primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        minus_touch := TouchArea {
                            clicked => {
                                root.step_minus();
                            }
                        }
                    }

                    // Value field: typed as well as stepped.
                    Rectangle {
                        width: 62px;
                        height: 28px;
                        border-radius: 4px;
                        background: Palette.bg_subtle;
                        border-width: 1px;
                        border-color: input.has-focus ? Palette.accent_primary : Palette.stroke_card;

                        accessible-role: button;
                        accessible-label: "Stack width field";
                        accessible-action-default => {
                            input.focus();
                            input.select-all();
                        }

                        // The whole box is the click target, not just the glyphs.
                        field_touch := TouchArea {
                            clicked => {
                                input.focus();
                                input.select-all();
                            }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 1px;

                            input := TextInput {
                                width: 26px;
                                text: "\{root.stack_width_percent}";
                                input-type: number;
                                single-line: true;
                                font-family: Typography.font_mono;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Palette.text_primary;
                                horizontal-alignment: right;
                                vertical-alignment: center;

                                accessible-role: text;
                                accessible-label: "Stack width input";
                                accessible-action-set-value(val) => {
                                    self.text = val;
                                    if val.is-float() {
                                        root.editing_width_changed(Math.round(val.to-float()));
                                    }
                                }

                                edited => {
                                    if self.text.is-float() {
                                        root.editing_width_changed(Math.round(self.text.to-float()));
                                    }
                                }

                                accepted => {
                                    root.commit_typed();
                                    self.clear-focus();
                                }
                                // Leaving the field commits it too, so a typed
                                // value is never silently dropped.
                                changed has-focus => {
                                    if !self.has-focus {
                                        root.commit_typed();
                                    }
                                }
                                key-pressed(event) => {
                                    if event.text == Key.Tab || event.text == Key.Backtab {
                                        root.commit_typed();
                                        return reject;
                                    }
                                    accept
                                }
                            }

                            Text {
                                text: "%";
                                font-family: Typography.font_mono;
                                font-size: 12.5px;
                                font-weight: 600;
                                color: Palette.text_secondary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Plus button
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 4px;
                        background: plus_touch.has_hover ? Palette.bg_card_hover : Palette.bg_keycap;
                        border-width: 1px;
                        border-color: Palette.stroke_card;

                        accessible-role: button;
                        accessible-label: "Increase stack width";
                        accessible-action-default => {
                            root.step_plus();
                        }

                        Text {
                            text: "+";
                            font-size: 14px;
                            font-weight: 700;
                            color: Palette.text_primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        plus_touch := TouchArea {
                            clicked => {
                                root.step_plus();
                            }
                        }
                    }
                }
            }
        }
    }
}
