import { Palette, Typography } from "../theme.slint";
import { Card, CardDivider } from "../components/card.slint";
import { SettingToggleRow } from "../components/setting_toggle_row.slint";

export component AboutPane inherits VerticalLayout {
    in property <string> version: "0.1.0";
    in property <string> typeface: "Segoe UI Variable Text (System Loaded)";

    // Updates. `status` is the one line the user reads, written by the Rust side for every
    // outcome, because "update failed" tells nobody anything -- see `update::describe`.
    in property <string> update_status: "";
    in property <bool> update_busy: false;
    in property <bool> update_ready: false;
    in property <string> update_version: "";
    in property <bool> update_has_notes: false;
    callback open_release_notes();
    in-out property <bool> check_updates: true;

    callback check_updates_clicked();
    callback install_update_clicked();
    callback check_updates_toggled(bool);
    callback open_publisher_url();
    callback open_source_url();
    callback open_support_url();

    spacing: 12px;
    alignment: start;

    // Heading Section
    VerticalLayout {
        spacing: 2px;
        Text {
            text: "Wira Desk";
            font-family: Typography.font_family;
            font-size: Typography.size_heading;
            font-weight: 700;
            color: Palette.text_primary;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Text {
                text: "Version " + root.version;
                font-family: Typography.font_family;
                font-size: Typography.size_caption;
                font-weight: 700;
                color: Palette.accent_primary;
            }

            Text {
                text: "•";
                font-size: Typography.size_caption;
                color: Palette.text_tertiary;
            }

            Text {
                text: "Typeface: " + root.typeface;
                font-family: Typography.font_family;
                font-size: Typography.size_caption;
                color: Palette.text_secondary;
            }
        }
    }


    Card {
        VerticalLayout {
            padding: 16px;
            spacing: 8px;

            Text {
                text: "Wira Desk switches smoothly between windows of the active application on your current monitor.";
                font-family: Typography.font_family;
                font-size: Typography.size_body;
                color: Palette.text_secondary;
                wrap: word-wrap;
            }

            Text {
                text: "Designed to be invisible, fast, and resource-efficient for all-day multitasking.";
                font-family: Typography.font_family;
                font-size: Typography.size_caption;
                color: Palette.text_tertiary;
                wrap: word-wrap;
            }
        }
    }

    // Updates.
    //
    // In About rather than General because this is where a version number already lives, and
    // "which version am I on" and "is there a newer one" are the same question asked twice.
    Card {
        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            SettingToggleRow {
                title: "Check for updates automatically";
                description: "The only time Wira Desk contacts the internet. Nothing about you is sent.";
                checked <=> root.check_updates;
                toggled(val) => { root.check_updates_toggled(val); }
            }

            CardDivider {}

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 16px;
                spacing: 10px;
                alignment: start;

                // Two buttons, never both. "Check" until something is found, then "Install".
                // A single button that changes meaning is a button a user has to read twice.
                if !root.update_ready : Rectangle {
                    width: 132px;
                    height: 32px;
                    border-radius: 6px;
                    background: root.update_busy
                        ? Palette.bg_subtle
                        : (check_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle);
                    border-width: 1px;
                    border-color: Palette.stroke_card;

                    Text {
                        text: root.update_busy ? "Checking…" : "Check for updates";
                        font-family: Typography.font_family;
                        font-size: 12.5px;
                        font-weight: 600;
                        color: root.update_busy ? Palette.text_tertiary : Palette.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    check_touch := TouchArea {
                        enabled: !root.update_busy;
                        clicked => { root.check_updates_clicked(); }
                    }
                }

                if root.update_ready && root.update_has_notes : Rectangle {
                    width: 96px;
                    height: 32px;
                    border-radius: 6px;
                    background: notes_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle;
                    border-width: 1px;
                    border-color: Palette.stroke_card;

                    Text {
                        text: "What is new";
                        font-family: Typography.font_family;
                        font-size: 12.5px;
                        font-weight: 600;
                        color: Palette.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    notes_touch := TouchArea {
                        clicked => { root.open_release_notes(); }
                    }
                }

                if root.update_ready : Rectangle {
                    width: 150px;
                    height: 32px;
                    border-radius: 6px;
                    background: root.update_busy
                        ? Palette.text_tertiary
                        : (install_touch.has_hover ? Palette.accent_hover : Palette.accent_primary);

                    Text {
                        text: root.update_busy ? "Downloading…" : "Download and install";
                        font-family: Typography.font_family;
                        font-size: 12.5px;
                        font-weight: 700;
                        color: Palette.text_on_accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    install_touch := TouchArea {
                        enabled: !root.update_busy;
                        clicked => { root.install_update_clicked(); }
                    }
                }
            }

            if root.update_ready : HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 8px;
                Text {
                    text: "Wira Desk will close, Windows will ask for your permission, and version "
                        + root.update_version + " will install. Your settings are kept.";
                    font-family: Typography.font_family;
                    font-size: Typography.size_caption;
                    color: Palette.text_secondary;
                    wrap: word-wrap;
                }
            }

            if root.update_status != "" : HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 8px;
                Text {
                    text: root.update_status;
                    font-family: Typography.font_family;
                    font-size: Typography.size_caption;
                    color: Palette.text_secondary;
                    wrap: word-wrap;
                }
            }
        }
    }

    // Publisher, Source Code, and Licensing Card (SPEC-11-03)
    Card {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Publisher Attribution Link
            HorizontalLayout {
                alignment: start;

                publisher_touch := TouchArea {
                    accessible-role: button;
                    accessible-label: "An open-source utility by Wira Digital Indonesia";
                    clicked => { root.open_publisher_url(); }

                    Text {
                        text: "An open-source utility by Wira Digital Indonesia";
                        font-family: Typography.font_family;
                        font-size: Typography.size_body;
                        font-weight: 500;
                        color: publisher_touch.has_hover ? Palette.accent_hover : Palette.accent_primary;
                    }
                }
            }

            CardDivider {}

            // GitHub Repository & Issues Link
            HorizontalLayout {
                alignment: start;

                repo_touch := TouchArea {
                    accessible-role: button;
                    accessible-label: "Source code & issue tracker on GitHub";
                    clicked => { root.open_source_url(); }

                    Text {
                        text: "Source code & issue tracker on GitHub";
                        font-family: Typography.font_family;
                        font-size: Typography.size_body;
                        color: repo_touch.has_hover ? Palette.accent_hover : Palette.text_primary;
                    }
                }
            }

            CardDivider {}

            // License & Offline Statement
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Licensed under GPL-3.0 • Standalone Desktop Utility";
                    font-family: Typography.font_family;
                    font-size: Typography.size_caption;
                    font-weight: 600;
                    color: Palette.text_secondary;
                }
                Text {
                    text: "No telemetry, no account, no background updater service — HTTPS requests to GitHub occur only when checking for or installing updates, which you can switch off.";
                    font-family: Typography.font_family;
                    font-size: Typography.size_caption;
                    color: Palette.text_tertiary;
                    wrap: word-wrap;
                }
            }

            CardDivider {}

            // Support Development Action
            HorizontalLayout {
                alignment: start;

                Rectangle {
                    width: 160px;
                    height: 32px;
                    border-radius: 6px;
                    background: support_touch.has_hover ? Palette.bg_card_hover : Palette.bg_subtle;
                    border-width: 1px;
                    border-color: Palette.stroke_card;

                    Text {
                        text: "Support development";
                        font-family: Typography.font_family;
                        font-size: 12.5px;
                        font-weight: 600;
                        color: Palette.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    support_touch := TouchArea {
                        accessible-role: button;
                        accessible-label: "Support development";
                        clicked => { root.open_support_url(); }
                    }
                }
            }
        }
    }
}
